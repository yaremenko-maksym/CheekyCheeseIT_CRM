# Database
DATABASE_URL=postgresql://crm_user:password@localhost:5432/crm_db

# Redis
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# App
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
VITE_API_URL=http://localhost:3001/api
JWT_SECRET=
SESSION_SECRET=
FRONTEND_URL=http://localhost:3000

# S3 / MinIO config
# Dev defaults point to local MinIO (docker-compose up minio).
# Prod = Cloudflare R2 (see docs/runbooks/s3-storage.md):
#   - S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   - S3_FORCE_PATH_STYLE=false
#   - S3_REGION=auto
#   - S3_BUCKET=crm-documents-prod
#   - AWS_* keys = R2 API token (Access Key ID / Secret), не IAM
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=crm-documents
# Dev/MinIO AND prod (Cloudflare R2) both leave this false: R2 rejects the
# SSE-S3 header (NotImplemented) and encrypts at rest by default. Set `true`
# ONLY for real AWS S3.
S3_USE_SSE=false
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

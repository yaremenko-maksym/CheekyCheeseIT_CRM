# Database
DATABASE_URL=postgresql://crm_user:password@localhost:5432/crm_db

# Redis
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# App
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
VITE_API_URL=http://localhost:3001/api
JWT_SECRET=
SESSION_SECRET=
FRONTEND_URL=http://localhost:3000

# S3 / MinIO config
# Dev defaults point to local MinIO (docker-compose up minio).
# Prod (see docs/runbooks/s3-storage.md):
#   - S3_ENDPOINT unset (uses default AWS endpoint)
#   - S3_FORCE_PATH_STYLE=false
#   - S3_REGION=eu-central-1 (Frankfurt, ~30ms latency для Украины)
#   - S3_BUCKET=crm-documents-prod
#   - AWS_* keys = least-privilege IAM user (см. runbook)
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=crm-documents
S3_USE_SSE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# set -e, explicit (code review 5113333031, CR-M-3): this used to rely ENTIRELY
# on husky's own wrapper (.husky/_/h) invoking every hook via `sh -e "$s"` --
# correct in production, but invisible to anyone testing this file directly.
# `bash .husky/pre-push` (exactly the command this file's own PR body used for
# manual verification) runs WITHOUT -e unless the file declares it itself, so a
# failing `pnpm typecheck` could be silently outrun by the `&&`-chain after it
# and still exit 0 -- which is precisely why a reviewer could not reproduce a
# claimed "Exit status 1": the reproduction command and the production
# invocation were not exercising the same semantics. Declaring it here makes
# `bash script`, `sh script`, and husky's `sh -e script` all behave identically
# -- the correctness property no longer depends on which one somebody used.
set -e

# Non-blocking warn: lessons.md cap (RULES.md §6.4) — nudge к консолидации, не блокер.
bash scripts/check-lessons-cap.sh || true

# Scoped by diff against the merge-base with origin/main (task-prepush-scope,
# backlog item 140, 2026-09-04) — was: unconditional `pnpm typecheck` + four
# FULL sequential test suites (~6600 tests) on every push, regardless of what
# changed. Backlog 140's own incident: a one-line edit to ci.yml cost 5-10
# minutes per attempt, and two of those attempts failed on OTHER packages'
# tests timing out under concurrent-agent CPU load, not on anything the diff
# touched. This hook stops paying for packages the diff never touched.
#
# CI remains the real, unscoped gate: required checks on the PR always run
# the full suite (see .github/workflows/ci.yml), independent of what this
# local hook decided. This is a local speed/contention optimization, not a
# substitute for CI — a cross-package regression this hook's scoping misses
# locally is still caught there before merge.
#
# Escape hatch for anyone who wants the old unscoped behavior locally (e.g.
# to double-check a cross-package change before opening the PR):
#   PREPUSH_FULL=1 git push
#
# run_full_suite (code review 5112543557, CR-M-1): this body used to be
# duplicated byte-for-byte at every call site below (PREPUSH_FULL=1,
# merge-base unresolvable, and now the dependency/build-config case a diff
# below adds) — one function, three callers, instead of three copies that
# could drift out of sync with each other.
run_full_suite() {
  pnpm typecheck
  # Run packages sequentially so each vitest worker gets full CPU budget.
  # Parallel fork-pools (shared + api + web) competed for CPU under load,
  # causing contract-pdf / compression / phone-input tests to time out even
  # though they pass in isolation. Sequential runs are ~30 s slower on an
  # idle machine but deterministic under any load. (2026-06-14 fix, PR #206)
  pnpm --filter @crm/shared test && pnpm --filter @crm/api test && pnpm --filter @crm/web test && pnpm --filter @crm/landing test
}

if [ "${PREPUSH_FULL:-0}" = "1" ]; then
  echo "pre-push: PREPUSH_FULL=1 — running the full unscoped suite (typecheck + shared/api/web/landing)"
  run_full_suite
  exit 0
fi

base="$(git merge-base HEAD origin/main 2>/dev/null || true)"
if [ -z "$base" ]; then
  echo "pre-push: could not resolve merge-base with origin/main (no origin/main ref locally?) — falling back to the full suite"
  run_full_suite
  exit 0
fi

changed="$(git diff --name-only "$base"...HEAD)"

# CR-M-2 (code review 5112543557): the apps/**|packages/** check below only
# looks at where a file LIVES, not at what it can AFFECT. A dependency/build
# -config file changes behavior for every package that reads it, regardless
# of which directory it happens to sit in -- pnpm-lock.yaml (or any
# package.json, root or per-package) can move a version every package
# resolves against; turbo.json and tsconfig.base.json are globalDependencies
# for every task's cache hash (see turbo.json's own comment on that); a
# package's vitest.config.* changes what that package's OWN "test" task
# actually runs; pnpm-workspace.yaml (CR-M-4, review 5113333031) is the
# workspace's own package glob ('apps/*', 'packages/*') -- changing it can
# add or remove packages from the whole monorepo, which no per-package
# `--filter` could ever see either. None of that is visible to a per-package
# `--filter`, so scoping here would be silently wrong, not just
# slower-than-ideal -- this check runs BEFORE the apps/packages skip-check
# below and, on a match, goes straight to the same full run PREPUSH_FULL=1
# uses.
if printf '%s\n' "$changed" | grep -qE '(^|/)(pnpm-lock\.yaml|pnpm-workspace\.yaml|package\.json|turbo\.json|tsconfig[^/]*\.json|vitest\.config\.[^/]+|\.npmrc)$'; then
  echo "pre-push: dependency/build-config file changed — running the full suite (per-package scoping cannot see its effect)"
  run_full_suite
  exit 0
fi

if ! printf '%s\n' "$changed" | grep -qE '^(apps|packages)/'; then
  echo "pre-push: no product code in diff — tests skipped (CI runs the full suite)"
  exit 0
fi

# --filter="...[$base]" — packages changed since $base PLUS their dependents
# (turbo's own package-boundary-aware selection; the grep above is only a
# cheap pre-check to decide whether to invoke turbo at all, not what it runs).
# --concurrency=1 preserves the same "one package's vitest workers get the
# full CPU budget" invariant PR #206 fixed above, now for however many
# packages this diff selects (e.g. a packages/shared change selects all of
# shared+api+web+landing — running those four in parallel would reproduce
# the exact timeout class #206 fixed, just scoped to fewer packages).
#
# Two separate invocations, not one `turbo run typecheck test`: @crm/e2e's
# own "test" script is `playwright test` (apps/e2e/package.json) -- a real
# browser E2E run that this hook has never driven and cannot: no app stack
# is up, so it would either hang/fail against nothing or (depending on
# playwright.config.ts's webServer setting) try to BOOT one from a git push,
# which is a much worse surprise than a slow push. E2E stays what it always
# was here -- a deliberate separate step (`pnpm --filter @crm/e2e test`, or
# CI's own e2e.yml) -- so the "test" turbo call carries an explicit
# `--filter="!@crm/e2e"` on top of "...[$base]" (turbo unions positive
# filters and then subtracts any `!`-prefixed one from that union, so this
# removes e2e from "test" specifically, not from the diff-selection itself).
# @crm/e2e's own "typecheck" script is plain `tsc --noEmit` -- no browser,
# no server, same cost class as every other package's typecheck -- so it is
# NOT excluded from the first call; a diff limited to apps/e2e/** still gets
# typechecked, just never gets Playwright.
pnpm exec turbo run typecheck --filter="...[$base]" --concurrency=1
pnpm exec turbo run test --filter="...[$base]" --filter="!@crm/e2e" --concurrency=1

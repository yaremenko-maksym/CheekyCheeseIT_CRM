# set -e, explicit (code review 5113333031, CR-M-3): this used to rely ENTIRELY
# on husky's own wrapper (.husky/_/h) invoking every hook via `sh -e "$s"` --
# correct in production, but invisible to anyone testing this file directly.
# `bash .husky/pre-push` (exactly the command this file's own PR body used for
# manual verification) runs WITHOUT -e unless the file declares it itself, so a
# failing `pnpm typecheck` could be silently outrun by the `&&`-chain after it
# and still exit 0 -- which is precisely why a reviewer could not reproduce a
# claimed "Exit status 1": the reproduction command and the production
# invocation were not exercising the same semantics. Declaring it here makes
# `bash script`, `sh script`, and husky's `sh -e script` all behave identically
# -- the correctness property no longer depends on which one somebody used.
set -e

# Non-blocking warn: lessons.md cap (RULES.md §6.4) — nudge к консолидации, не блокер.
bash scripts/check-lessons-cap.sh || true

# Scoped by diff against the merge-base with origin/main (task-prepush-scope,
# backlog item 140, 2026-09-04) — was: unconditional `pnpm typecheck` + four
# FULL sequential test suites (~6600 tests) on every push, regardless of what
# changed. Backlog 140's own incident: a one-line edit to ci.yml cost 5-10
# minutes per attempt, and two of those attempts failed on OTHER packages'
# tests timing out under concurrent-agent CPU load, not on anything the diff
# touched. This hook stops paying for packages the diff never touched.
#
# CI remains the real, unscoped gate: required checks on the PR always run
# the full suite (see .github/workflows/ci.yml), independent of what this
# local hook decided. This is a local speed/contention optimization, not a
# substitute for CI — a cross-package regression this hook's scoping misses
# locally is still caught there before merge.
#
# Escape hatch for anyone who wants the old unscoped behavior locally (e.g.
# to double-check a cross-package change before opening the PR):
#   PREPUSH_FULL=1 git push
#
# ensure_node -- run the gate on the project's canonical Node, never on whatever
# `node` the calling shell happens to have first on PATH (2026-10-17).
#
# Incident: two coder agents lost several push attempts each. The hook ran on the
# sandbox default (Node 20.15.1) and `@crm/shared` + `@crm/api` failed on every
# uk-catalog spec: packages/shared/src/i18n/catalog.ts loads the compiled
# `messages.ts` via `require('<path>.ts')`, which only works with Node >= 22's
# built-in type stripping (".nvmrc" = 22; "engines" = ">=22.19 <23"; rationale in
# .claude/rules/common/version-pins.md). On Node 20 that is "SyntaxError: Cannot use
# import statement outside a module". The "workaround" (warm the turbo cache from
# a Node 22 shell, then push "from cache") worked for a reason that is itself a
# hazard: turbo's task hash does NOT include the Node version, so a pass cached
# under Node 22 replays as a hit under Node 20 -- measured, identical hash
# b51541a6e1d5a75f on both. Pinning the runtime here removes the need for it.
#
# Behaviour: (1) node already satisfies .nvmrc major + engines minimum -> nothing
# to do. (2) otherwise look for a satisfying install under nvm's standard layout
# ("${NVM_DIR:-$HOME/.nvm}/versions/node/v<major>.*", derived from the
# environment, nothing machine-specific committed), prepend it to PATH and SAY SO.
# (3) otherwise REFUSE with an actionable message. There is deliberately no silent
# fallback to the wrong Node and no escape-hatch variable: a loud refusal is the
# acceptable failure mode, a green gate on the wrong runtime is not.
#
# The minimum is read from the `engines.node` field SPECIFICALLY (awk over the
# "engines" block -- node itself cannot be used to parse package.json, the whole
# premise being that the resolved node may be the wrong one), never by a regex over
# the whole file: an earlier ">=22.1.0" elsewhere (volta, overrides) must not mask
# it. Understood lower bounds: ">=22.19[.p]", "^22.19[.p]", "~22.19[.p]", "22.19[.p]"
# (minimum 19), and "22.x" / ">=22" / "^22" / "22" (minimum 0, declared by the
# author, not guessed). Upper bounds ("<23") are skipped. Anything else -- no
# engines.node, "||" ranges, a form not listed -- REFUSES: an undeterminable
# minimum must never degrade to "any v22".
#
# Called lazily (from run_full_suite and before the first scoped turbo call), not
# at the top of the file, so a docs-only push -- which needs no node at all --
# is never refused over a toolchain it does not use.
die() {
  echo "pre-push: REFUSING to run the gate -- $1" >&2
  exit 1
}

node_ok() {
  nv="${1#v}"
  nmaj="${nv%%.*}"
  nrest="${nv#*.}"
  nmin="${nrest%%.*}"
  case "$nmaj$nmin" in *[!0-9]* | "") return 1 ;; esac
  [ "$nmaj" = "$want_major" ] && [ "$nmin" -ge "$want_minor" ]
}

engines_min() {
  # The whole file is one awk record (RS = control-A, which a JSON file cannot
  # contain); the scan walks characters from the "{" that opens the engines object
  # and stops at ITS matching "}", string-aware (a brace or quote inside a string,
  # or an escaped quote, does not count). So a one-line `"engines": {}` or
  # `{ "pnpm": "7" }` ends the scan right there and a later "node" key in another
  # block (volta, scripts) is never seen, and on a one-line object with a later
  # "node" on the same line the engines value still wins. No "node" key inside the
  # object -> empty output -> engines_min refuses.
  eng="$(awk '
    BEGIN { RS = "\001" }
    {
      s = $0
      if (!match(s, /"engines"[ \t\n\r]*:[ \t\n\r]*\{/)) exit
      p = RSTART + RLENGTH
      n = length(s)
      depth = 1
      instr = 0
      blk = ""
      while (p <= n) {
        ch = substr(s, p, 1)
        if (instr) {
          if (ch == "\\") {
            blk = blk ch substr(s, p + 1, 1)
            p += 2
            continue
          }
          if (ch == "\"") instr = 0
        } else if (ch == "\"") {
          instr = 1
        } else if (ch == "{") {
          depth++
        } else if (ch == "}") {
          depth--
          if (depth == 0) break
        }
        blk = blk ch
        p++
      }
      if (match(blk, /"node"[ \t\n\r]*:[ \t\n\r]*"[^"]*"/)) {
        v = substr(blk, RSTART, RLENGTH)
        sub(/^"node"[ \t\n\r]*:[ \t\n\r]*"/, "", v)
        sub(/"$/, "", v)
        print v
      }
    }
  ' package.json 2>/dev/null || true)"
  want_minor=""
  case "$eng" in *"||"*) eng="" ;; esac
  for t in $eng; do
    case "$t" in "<"* | ">"[!=]*) continue ;; esac
    c="${t#>=}"
    c="${c#^}"
    c="${c#\~}"
    case "$c" in
      "$want_major") m=0 ;;
      "$want_major".[xX*]) m=0 ;;
      "$want_major".[0-9]*)
        m="${c#*.}"
        m="${m%%.*}"
        ;;
      *) continue ;;
    esac
    case "$m" in "" | *[!0-9]*) continue ;; esac
    want_minor="$m"
    break
  done
  if [ -z "$want_minor" ]; then
    die "cannot determine the Node ${want_major} minimum from package.json engines.node (found: '${eng}'); supported: >=${want_major}.N, ^${want_major}.N, ~${want_major}.N, ${want_major}.N, ${want_major}.x, >=${want_major}."
  fi
}

ensure_node() {
  want_major="$(sed -n '1s/^v\{0,1\}\([0-9][0-9]*\).*/\1/p' .nvmrc 2>/dev/null || true)"
  if [ -z "$want_major" ]; then
    die "cannot read the required Node major from .nvmrc (run the push from the repo root)"
  fi
  engines_min
  cur="$(node -v 2>/dev/null || true)"
  if node_ok "$cur"; then
    return 0
  fi
  # Resolved to an ABSOLUTE path up front: a relative NVM_DIR would otherwise end up
  # as a relative PATH entry that silently points somewhere else after any `cd`.
  # (An unresolvable dir yields "" -> no candidate -> the loud refusal below.)
  nvm_root="$(cd "${NVM_DIR:-$HOME/.nvm}/versions/node" 2>/dev/null && pwd || true)"
  cand=""
  if [ -n "$nvm_root" ]; then
    # Sorted on the bare "v22.<minor>.<patch>" name, newest first, NUMERICALLY per
    # key -- never on the full path, whose own dots (e.g. /Users/first.last) would
    # shift the sort keys; and never lexically (v22.9.0 must lose to v22.10.0).
    cand="$( (cd "$nvm_root" 2>/dev/null && ls -d v"$want_major".* 2>/dev/null) | sort -t. -k2,2nr -k3,3nr | while IFS= read -r d; do
      if [ -x "$nvm_root/$d/bin/node" ] && node_ok "$("$nvm_root/$d/bin/node" -v 2>/dev/null)"; then
        echo "$nvm_root/$d/bin"
        break
      fi
    done)"
  fi
  if [ -n "$cand" ]; then
    echo "pre-push: node ${cur:-<none>} on PATH does not satisfy Node ${want_major}.${want_minor}+ (.nvmrc / engines); using $cand for this push"
    PATH="$cand:$PATH"
    export PATH
    hash -r 2>/dev/null || true
    if node_ok "$(node -v 2>/dev/null || true)"; then
      # Prepending that bin dir can also change which `pnpm` wins (an install's
      # global pnpm shadows the one the caller had). The repo pins pnpm via
      # "packageManager": "pnpm@x.y.z" (strict, version-pins.md) -- verify it
      # instead of assuming, but only here: when no switch happened pnpm
      # resolution is exactly what the caller already had.
      pnpm_pin="$(sed -n 's/^[[:space:]]*"packageManager"[[:space:]]*:[[:space:]]*"pnpm@\([^"]*\)".*/\1/p' package.json 2>/dev/null | head -n 1 || true)"
      # Corepack's format appends an integrity suffix ("pnpm@7.32.4+sha512.<hex>");
      # `pnpm --version` prints only the version, so compare against the bare one.
      pnpm_pin="${pnpm_pin%%+*}"
      if [ -n "$pnpm_pin" ]; then
        pnpm_got="$(pnpm --version 2>/dev/null || true)"
        if [ "$pnpm_got" != "$pnpm_pin" ]; then
          die "after switching to $cand, pnpm resolves to '${pnpm_got:-<none>}' but package.json pins pnpm@${pnpm_pin} -- that node's global pnpm shadows the pinned one; fix it there (npm i -g pnpm@${pnpm_pin}) or put the pinned pnpm first on PATH"
        fi
      fi
      return 0
    fi
  fi
  echo "pre-push: REFUSING to run the gate -- node ${cur:-<none>} on PATH does not satisfy Node ${want_major}.${want_minor}+ (.nvmrc / package.json engines)." >&2
  echo "pre-push: on the wrong Node the uk-catalog specs in @crm/shared and @crm/api fail with 'Cannot use import statement outside a module'." >&2
  echo "pre-push: install and select it, then push again:  nvm install ${want_major} && nvm use ${want_major}   (or put a Node ${want_major} bin dir first on PATH)" >&2
  exit 1
}

# run_full_suite (code review 5112543557, CR-M-1): this body used to be
# duplicated byte-for-byte at every call site below (PREPUSH_FULL=1,
# merge-base unresolvable, and now the dependency/build-config case a diff
# below adds) — one function, three callers, instead of three copies that
# could drift out of sync with each other.
run_full_suite() {
  ensure_node
  pnpm typecheck
  # Run packages sequentially so each vitest worker gets full CPU budget.
  # Parallel fork-pools (shared + api + web) competed for CPU under load,
  # causing contract-pdf / compression / phone-input tests to time out even
  # though they pass in isolation. Sequential runs are ~30 s slower on an
  # idle machine but deterministic under any load. (2026-06-14 fix, PR #206)
  pnpm --filter @crm/shared test && pnpm --filter @crm/api test && pnpm --filter @crm/web test && pnpm --filter @crm/landing test
}

if [ "${PREPUSH_FULL:-0}" = "1" ]; then
  echo "pre-push: PREPUSH_FULL=1 — running the full unscoped suite (typecheck + shared/api/web/landing)"
  run_full_suite
  exit 0
fi

base="$(git merge-base HEAD origin/main 2>/dev/null || true)"
if [ -z "$base" ]; then
  echo "pre-push: could not resolve merge-base with origin/main (no origin/main ref locally?) — falling back to the full suite"
  run_full_suite
  exit 0
fi

changed="$(git diff --name-only "$base"...HEAD)"

# CR-M-2 (code review 5112543557): the apps/**|packages/** check below only
# looks at where a file LIVES, not at what it can AFFECT. A dependency/build
# -config file changes behavior for every package that reads it, regardless
# of which directory it happens to sit in -- pnpm-lock.yaml (or any
# package.json, root or per-package) can move a version every package
# resolves against; turbo.json and tsconfig.base.json are globalDependencies
# for every task's cache hash (see turbo.json's own comment on that); a
# package's vitest.config.* changes what that package's OWN "test" task
# actually runs; pnpm-workspace.yaml (CR-M-4, review 5113333031) is the
# workspace's own package glob ('apps/*', 'packages/*') -- changing it can
# add or remove packages from the whole monorepo, which no per-package
# `--filter` could ever see either. None of that is visible to a per-package
# `--filter`, so scoping here would be silently wrong, not just
# slower-than-ideal -- this check runs BEFORE the apps/packages skip-check
# below and, on a match, goes straight to the same full run PREPUSH_FULL=1
# uses.
if printf '%s\n' "$changed" | grep -qE '(^|/)(pnpm-lock\.yaml|pnpm-workspace\.yaml|package\.json|turbo\.json|tsconfig[^/]*\.json|vitest\.config\.[^/]+|\.npmrc)$'; then
  echo "pre-push: dependency/build-config file changed — running the full suite (per-package scoping cannot see its effect)"
  run_full_suite
  exit 0
fi

if ! printf '%s\n' "$changed" | grep -qE '^(apps|packages)/'; then
  echo "pre-push: no product code in diff — tests skipped (CI runs the full suite)"
  exit 0
fi

# --filter="...[$base]" — packages changed since $base PLUS their dependents
# (turbo's own package-boundary-aware selection; the grep above is only a
# cheap pre-check to decide whether to invoke turbo at all, not what it runs).
# --concurrency=1 preserves the same "one package's vitest workers get the
# full CPU budget" invariant PR #206 fixed above, now for however many
# packages this diff selects (e.g. a packages/shared change selects all of
# shared+api+web+landing — running those four in parallel would reproduce
# the exact timeout class #206 fixed, just scoped to fewer packages).
#
# Product code is in the diff, so turbo is about to run: pin the runtime first
# (ensure_node, defined above -- switches to the project's Node 22 or refuses).
ensure_node

# Two separate invocations, not one `turbo run typecheck test`: @crm/e2e's
# own "test" script is `playwright test` (apps/e2e/package.json) -- a real
# browser E2E run that this hook has never driven and cannot: no app stack
# is up, so it would either hang/fail against nothing or (depending on
# playwright.config.ts's webServer setting) try to BOOT one from a git push,
# which is a much worse surprise than a slow push. E2E stays what it always
# was here -- a deliberate separate step (`pnpm --filter @crm/e2e test`, or
# CI's own e2e.yml) -- so the "test" turbo call carries an explicit
# `--filter="!@crm/e2e"` on top of "...[$base]" (turbo unions positive
# filters and then subtracts any `!`-prefixed one from that union, so this
# removes e2e from "test" specifically, not from the diff-selection itself).
# @crm/e2e's own "typecheck" script is plain `tsc --noEmit` -- no browser,
# no server, same cost class as every other package's typecheck -- so it is
# NOT excluded from the first call; a diff limited to apps/e2e/** still gets
# typechecked, just never gets Playwright.
# typecheck keeps the "...[$base]" (changed packages AND their dependents):
# it is cheap (plain tsc --noEmit, no server/browser) and catches the most
# common cross-package regression there is -- a changed shared type breaking
# every package that consumes it -- which is exactly the class worth paying
# for locally before a push.
pnpm exec turbo run typecheck --filter="...[$base]" --concurrency=1

# TEST uses "[$base]" (changed packages ONLY, no leading "..." -> no
# dependents) -- deliberately NARROWER than typecheck above.
# (durable pre-push lightening, 2026-10-05)
#
# Why: this hook was already package-scoped (backlog 140), but a single
# packages/shared edit still expanded via "...[$base]" to shared+api+web+
# landing and ran all four full vitest suites sequentially -- the dominant
# cost left in the hook and the thing that timed pushes out under
# concurrent-agent CPU load. Narrowing TEST to directly-changed packages
# keeps the high-value local signal ("the package I actually edited still
# passes its own tests before I push") while deferring dependents' BEHAVIORAL
# verification to CI.
#
# Why this is safe, not a hole: CI's required checks run the full, unscoped
# suite on the PR regardless of what this local hook decided (see
# .github/workflows/ci.yml) -- a dependent-package behavioral regression a
# shared change introduces is still caught there before merge. And the
# cross-package regression most likely to slip (a shared type/contract
# change) is a TYPE break, which the typecheck line above still catches
# locally with full dependent coverage. What moves to CI-only is the narrow
# case of a shared change that breaks a dependent's RUNTIME behavior without
# breaking its types -- rare, and never merged because CI blocks it.
#
# Escape hatch: PREPUSH_FULL=1 git push  (runs the full unscoped suite,
# dependents included -- see run_full_suite above) for anyone who wants the
# old dependents-included local test run before opening a cross-package PR.
pnpm exec turbo run test --filter="[$base]" --filter="!@crm/e2e" --concurrency=1

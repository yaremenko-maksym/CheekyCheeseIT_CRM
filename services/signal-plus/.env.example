# signal-plus configuration. Copy to .env (gitignored) and fill in real
# values. Nothing here is a real secret -- these are illustrative only.
# See README.md for what each mode/behaviour actually does.

# --- Required (requirement 1) ---------------------------------------------

# The signal-cli-linked account that sends the "+", in E.164 format.
SIGNAL_ACCOUNT=+380501234567

# The Signal group id (as printed by `signal-plus --groups`) to send "+" to.
SIGNAL_GROUP_ID=group.abc123def456==

# Path to the signal-cli executable to run. In production this should point
# at $SIGNAL_DATA_DIR/bin/current (the symlink the updater maintains); see
# README.md "Auto-update" for why the service never runs a path baked into
# the image directly.
SIGNAL_CLI_BIN=/data/signal-cli/bin/current

# Path to the JSON state file (idempotency, update-attempt tracking). Must
# be on a volume that survives container restarts.
STATE_FILE=/data/signal-plus/state.json

# --- Optional: auto-update (requirement 8) ---------------------------------

# Volume root for signal-cli binaries + downloaded updates. If unset, the
# auto-updater refuses to run (fails closed) and only ever uses the image's
# pinned build.
SIGNAL_DATA_DIR=/data/signal-cli

# GPG fingerprint (40 hex chars, no spaces) the release .asc signature must
# match. If unset, the auto-updater refuses to run (fails closed) --
# trust-on-first-use is never acceptable here. See signal_plus/updater.py's
# module docstring for how the default value was obtained and verified.
SIGNAL_CLI_GPG_FINGERPRINT=FA10826A74907F9EC6BBB7FC2BA2CD21B5B09570

# --- Optional: alerting (requirement 10) ------------------------------------

# Personal Signal recipient (E.164) for alert DMs. If unset, that alert
# layer is silently skipped (the other two layers -- log + GitHub issue --
# still run independently).
SIGNAL_ALERT_RECIPIENT=+380509998877

# --- Read opportunistically by the GitHub-issue alert layer, if already
# present in this service's environment (see signal_plus/alert.py and
# signal_plus/cli.py's _issue_alert_env -- full wiring is step 4/DevOps) ----
# ALERT_REPO=owner/repo
# GH_TOKEN=

{
  // BUILD ONLY. `tsconfig.json` is what `typecheck` uses and it keeps the specs;
  // this one drops them, for two reasons:
  //
  //   * they were being compiled into `dist` and published with the package,
  //     which no consumer of `@crm/shared` wants;
  //   * a spec imports test data from `../../test-helpers/` (the URL corpus,
  //     shared with the web guard's test — see that file's header). With specs in
  //     the build graph, that single import above `src` moves tsc's INFERRED
  //     `rootDir` up to the package root, which silently relays the whole `dist`
  //     layout (`dist/src/index.js` instead of `dist/index.js`) and breaks the
  //     `main`/`types` entry points. Excluding specs keeps the inferred rootDir
  //     at `src`, where it has always been.
  //
  // Nothing is lost by the split: the specs still typecheck via `tsconfig.json`,
  // and they are run by vitest, which does its own transform.
  "extends": "./tsconfig.json",
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts", "src/**/*.test.ts"]
}

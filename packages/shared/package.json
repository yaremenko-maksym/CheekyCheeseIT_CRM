{
  "name": "@crm/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./public": {
      "types": "./dist/public.d.ts",
      "source": "./src/public.ts",
      "default": "./dist/public.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "tsc --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lingui/core": "5.9.5",
    "@lingui/message-utils": "5.9.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

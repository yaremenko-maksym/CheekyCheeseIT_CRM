{
  "name": "@crm/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./public": {
      "types": "./dist/public.d.ts",
      "source": "./src/public.ts",
      "default": "./dist/public.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/eslint-plugin": "^1.6.26",
    "eslint": "^10.3.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}

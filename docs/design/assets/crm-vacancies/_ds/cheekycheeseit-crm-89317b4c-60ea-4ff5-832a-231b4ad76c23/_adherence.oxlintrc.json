{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/Alert/**",
              "components/general/AlertDialog/**",
              "components/general/AnimatedTabs/**",
              "components/general/Avatar/**",
              "components/general/Badge/**",
              "components/general/Button/**",
              "components/general/Calendar/**",
              "components/general/Card/**",
              "components/general/Command/**",
              "components/general/CrmDialogContent/**",
              "components/general/DatePickerField/**",
              "components/general/Dialog/**",
              "components/general/DropdownMenu/**",
              "components/general/ImageUploadField/**",
              "components/general/Input/**",
              "components/general/Label/**",
              "components/general/PhoneInput/**",
              "components/general/Popover/**",
              "components/general/RadioGroup/**",
              "components/general/RoleSelect/**",
              "components/general/ScrollArea/**",
              "components/general/SegmentedToggle/**",
              "components/general/Select/**",
              "components/general/Separator/**",
              "components/general/ShareSlider/**",
              "components/general/Sheet/**",
              "components/general/Skeleton/**",
              "components/general/SliderNumberInput/**",
              "components/general/Table/**",
              "components/general/Tabs/**",
              "components/general/TechAutocompleteInput/**",
              "components/general/Textarea/**",
              "components/general/Toaster/**",
              "components/general/Tooltip/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],

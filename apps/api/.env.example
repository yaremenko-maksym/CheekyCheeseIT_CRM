NODE_ENV=development
API_PORT=3001

DATABASE_URL=postgresql://crm_user:password@localhost:5432/crm_db
REDIS_URL=redis://localhost:6379

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Secrets — min 32 chars each
JWT_SECRET=change_me_at_least_32_characters_long
SESSION_SECRET=change_me_at_least_32_characters_long
# AES-256-GCM key for project credential passwords (at-rest encryption).
# Generate a strong value: openssl rand -hex 32
# REQUIRED to be a non-default value in production (validated at startup).
CREDENTIALS_ENC_KEY=change_me_run_openssl_rand_hex_32

FRONTEND_URL=http://localhost:3000

# Cloudflare Turnstile — public vacancy-apply spam guard.
# Dev/test default is Cloudflare's documented "always passes" secret — never
# use it in production. https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google Indexing API — service-account credentials for near-instant Google
# re-crawl of published/closed vacancy JobPosting pages. BOTH optional and
# left unset here on purpose: unset in dev/CI, GoogleIndexingService runs in
# no-op mode with a one-time boot warning (vacancy publish/close still works,
# just without the "instant" indexing signal). Provisioning steps — see the
# runbook section "Google Indexing API".
GOOGLE_INDEXING_SA_EMAIL=
# Base64-encoded PEM private key for the same service account (RS256 JWT
# signing). Generate: `base64 -i service-account-key.json` is WRONG — encode
# only the `private_key` PEM string, not the whole JSON key file.
GOOGLE_INDEXING_SA_KEY_B64=

# Base origin for public vacancy URLs sent to the Google Indexing API
# (`<origin>/careers/<slug>/`). Defaults to the production landing domain —
# override only for non-standard deploys.
PUBLIC_LANDING_ORIGIN=https://cheekycheese.tech

# task-telemetry-api — checked against the `X-Telemetry-Token` header on
# GET /api/telemetry/digest (constant-time compare). Consumed by
# .github/workflows/telemetry-digest.yml. Dev/CI default below is public —
# NEVER use it in production. Generate: `openssl rand -hex 32`.
TELEMETRY_DIGEST_TOKEN=dev-only-telemetry-digest-token-change-in-production-0000

# task-telemetry-api — secret input to the daily salt used to derive
# telemetry_events.session_hash (never stores a raw userId). Dev/CI default
# below is public — NEVER use it in production. Generate: `openssl rand -hex 32`.
TELEMETRY_SESSION_SALT=dev-only-telemetry-session-salt-change-in-production-0000

NODE_ENV=development
API_PORT=3001

DATABASE_URL=postgresql://crm_user:password@localhost:5432/crm_db
REDIS_URL=redis://localhost:6379

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Secrets — min 32 chars each
JWT_SECRET=change_me_at_least_32_characters_long
SESSION_SECRET=change_me_at_least_32_characters_long
# AES-256-GCM key for project credential passwords (at-rest encryption).
# Generate a strong value: openssl rand -hex 32
# REQUIRED to be a non-default value in production (validated at startup).
CREDENTIALS_ENC_KEY=change_me_run_openssl_rand_hex_32

FRONTEND_URL=http://localhost:3000

# Cloudflare Turnstile — public vacancy-apply spam guard.
# Dev/test default is Cloudflare's documented "always passes" secret — never
# use it in production. https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google Indexing API — service-account credentials for near-instant Google
# re-crawl of published/closed vacancy JobPosting pages. BOTH optional and
# left unset here on purpose: unset in dev/CI, GoogleIndexingService runs in
# no-op mode with a one-time boot warning (vacancy publish/close still works,
# just without the "instant" indexing signal). Provisioning steps — see the
# runbook section "Google Indexing API".
GOOGLE_INDEXING_SA_EMAIL=
# Base64-encoded PEM private key for the same service account (RS256 JWT
# signing). Generate: `base64 -i service-account-key.json` is WRONG — encode
# only the `private_key` PEM string, not the whole JSON key file.
GOOGLE_INDEXING_SA_KEY_B64=

# Base origin for public vacancy URLs sent to the Google Indexing API
# (`<origin>/careers/<slug>/`). Defaults to the production landing domain —
# override only for non-standard deploys.
PUBLIC_LANDING_ORIGIN=https://cheekycheese.tech

# task-telemetry-api — checked against the `X-Telemetry-Token` header on
# GET /api/telemetry/digest (constant-time compare). Consumed by
# .github/workflows/telemetry-digest.yml. Dev/CI default below is public —
# NEVER use it in production. Generate: `openssl rand -hex 32`.
TELEMETRY_DIGEST_TOKEN=dev-only-telemetry-digest-token-change-in-production-0000

# task-telemetry-api — secret input to the daily salt used to derive
# telemetry_events.session_hash (never stores a raw userId). Dev/CI default
# below is public — NEVER use it in production. Generate: `openssl rand -hex 32`.
TELEMETRY_SESSION_SALT=dev-only-telemetry-session-salt-change-in-production-0000

# task-landing-contact-and-hiring-strip — Resend HTTP API key for the public
# "Start a project" contact form (POST /api/public/contact). Left UNSET here
# on purpose: no npm SDK dependency, plain fetch to https://api.resend.com.
# Without a key, ContactModule still boots (one warning log) and the endpoint
# responds 503 pointing visitors at CONTACT_PUBLIC_EMAIL — provisioning a real
# key is a separate devops task, not required to run the API locally.
RESEND_API_KEY=
# "From" address Resend sends contact-form emails as — must be a verified
# sender/domain in the Resend account.
CONTACT_FROM_EMAIL=site@cheekycheese.tech
# Visible fallback address shown to visitors (landing UI + the 502/503 error
# copy) when the form is unavailable or a send ultimately fails.
CONTACT_PUBLIC_EMAIL=hr@cheekycheese.tech

# task-resume-base — Cloudflare Workers AI, used ONCE per resume upload to turn
# extracted PDF/DOCX text into structured content. Both left UNSET here on
# purpose: the API boots without them, ResumeAiService logs one warning and
# every extraction reports AI_NOT_CONFIGURED, and the resume form stays fully
# fillable by hand. Tests NEVER call the live API (the client is stubbed).
# Free tier: 10 000 Neurons/day, reset 00:00 UTC; Cloudflare BLOCKS the request
# past the allowance rather than billing.
#   CLOUDFLARE_ACCOUNT_ID — Cloudflare dashboard -> Workers & Pages -> Account ID
#   CLOUDFLARE_AI_TOKEN   — API token with the "Workers AI: Read" permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# task-vacancy-matching — stack-match score below which a suggested vacancy is
# COLLAPSED in the senior's queue. Collapsed is not hidden: the UI still shows
# "ещё N с низким совпадением" and opens them on one click, so tuning this only
# moves the fold, it never discards a vacancy.
#
# A setting rather than a constant because the score's denominator is however
# many skills the senior listed: a studio whose seniors write 40 skills wants a
# lower threshold than one whose seniors write 8. Range 0..1, default 0.2
# (deliberately forgiving — collapsing a good vacancy costs more than showing a
# mediocre one). 0 = collapse nothing.
#
# Validated at BOOT: a non-numeric or out-of-range value refuses to start
# instead of silently disabling the fold (NaN makes every comparison false), and
# an EMPTY value falls back to the default rather than being read as 0.
JOB_MATCH_THRESHOLD=0.2

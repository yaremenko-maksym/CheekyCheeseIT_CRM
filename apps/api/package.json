{
  "name": "@crm/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build && node scripts/check-di-metadata.cjs",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "turbo run build --filter=@crm/shared && tsc --noEmit",
    "typecheck:specs": "turbo run build --filter=@crm/shared && tsc --noEmit -p tsconfig.spec.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/database/seed-db-guard.ts && drizzle-kit push",
    "db:push": "tsx src/database/seed-db-guard.ts && drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@crm/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "google-auth-library": "^10.4.0",
    "heic-convert": "^2.1.0",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.3",
    "unpdf": "^1.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/heic-convert": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/eslint-plugin": "^1.6.26",
    "dotenv": "17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^4.1.8"
  }
}

          "504": {
            "description": "Request timeout — the search exceeded its server-side budget. Retry with a narrower query.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "operationId": "searchJobsPost"
      }
    },

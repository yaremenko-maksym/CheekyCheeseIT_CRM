                          "type": "integer"
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    },
                    "browseOnSiteUrl": {
                      "type": "string",
                      "description": "Human-facing link to this same search rendered on jobgether.com. NOT a paginator — does not return more or different results than this response; use `page`/`limit` for pagination instead."
                    },
                    "docs": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter, or a malformed JSON body. For an out-of-range value the offending `field` and its `allowedValues` are returned inline so a caller can self-correct and retry.",
            "content": {

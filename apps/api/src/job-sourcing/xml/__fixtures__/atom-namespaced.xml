<?xml version="1.0" encoding="utf-8"?>
<!--
  SYNTHETIC. Not fetched from any board. Shape assembled from the Atom 1.0 spec
  (RFC 4287) plus the RSS content module, to exercise every namespace construct the
  r5 plan names: a default namespace, a prefixed vocabulary, a content:encoded CDATA
  payload, several link relations and two authors.

  Deliberately uses the NON-conventional prefix `c` for the content module, so a
  mapper matching on the literal prefix `content:` fails here while one resolving the
  namespace URI passes. That asymmetry is the point of the fixture.
-->
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:c="http://purl.org/rss/1.0/modules/content/">
  <title>Example Jobs</title>
  <id>urn:uuid:60a76c80-d399-11d9-b93c-0003939e0af6</id>
  <link rel="self" href="https://example.com/feed" />
  <entry>

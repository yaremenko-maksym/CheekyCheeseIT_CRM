// Theme `technical`: skills one per line, plain rules. Prepended to resume-skeleton.typ.
// A theme may set ONLY these keys; the skeleton owns structure (spec §6).
#let theme = (
  font: "Roboto",
  accent: rgb("#0f5132"),
  muted: rgb("#4d5560"),
  name-size: 1.7em,
  name-align: left,
  heading-size: 1.05em,
  heading-weight: "bold",
  heading-rule: none,
  margin-scale: 0.9,
  spacing-scale: 0.9,
  date-on-role-line: false,
  skills-one-per-line: true,
)

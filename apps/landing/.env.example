# Cloudflare Turnstile — public vacancy-apply form spam guard (landing).
# Dev/test value is Cloudflare's documented "always passes" test site key —
# safe for local dev, never for production (build fails loud on the prod
# secret side if it leaks there — see apps/api/.env.example / env.ts).
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

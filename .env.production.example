# ============================================================
# .env.production.example
#
# Copy to .env.production and fill in real values:
#   cp .env.production.example .env.production
#
# NEVER commit .env.production to git (it's in .gitignore).
# Mark: [REQUIRED] — must be set before starting the stack.
#       [OPTIONAL] — has a safe default or is feature-dependent.
# ============================================================

# ── App / Runtime ────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001

# ── Database (PostgreSQL 16) ─────────────────────────────────────────────
# [REQUIRED] Full connection string used by Drizzle ORM.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# With docker-compose.prod.yml services, host = "postgres" (service name).
DATABASE_URL=postgresql://crm_user:CHANGE_ME@postgres:5432/crm_db

# Compose-level credentials used to init the PostgreSQL container.
# Must match the user/password in DATABASE_URL above.
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ────────────────────────────────────────────────────────────────
# [REQUIRED] With compose, host = "redis" (service name).
REDIS_URL=redis://redis:6379

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────
# [REQUIRED] Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [REQUIRED] Full callback URL registered in Google Cloud Console.
# Must be: https://app.cheekycheese.tech/api/auth/google/callback
# (NestJS prefix is "api", the route is /auth/google/callback)
GOOGLE_CALLBACK_URL=https://app.cheekycheese.tech/api/auth/google/callback

# ── Auth secrets ─────────────────────────────────────────────────────────
# [REQUIRED] Minimum 32 characters. Generate with: openssl rand -base64 32
JWT_SECRET=

# [REQUIRED] Minimum 32 characters. Used for @fastify/cookie signing.
SESSION_SECRET=

# [REQUIRED] Minimum 32 characters. Used for credentials encryption (CREDENTIALS_ENC_KEY).
# Must be exactly 32 bytes for AES-256. Generate: openssl rand -base64 32
CREDENTIALS_ENC_KEY=

# ── Frontend / CORS ──────────────────────────────────────────────────────
# [REQUIRED] Primary frontend origin (used in CORS + email links).
FRONTEND_URL=https://app.cheekycheese.tech

# [REQUIRED] Comma-separated list of allowed CORS origins.
# Added by PR3b to apps/api/src/config/env.ts.
# Both domains must be listed (CRM + Landing, for future cross-domain needs).
CORS_ORIGINS=https://app.cheekycheese.tech,https://cheekycheese.tech

# [REQUIRED] Set to true when API is behind a reverse-proxy (nginx).
# Enables Fastify's trust proxy so X-Forwarded-* headers are respected.
# Added by PR3b to apps/api/src/config/env.ts.
TRUST_PROXY=true

# ── S3 / Object Storage ──────────────────────────────────────────────────
# Prod provider: Cloudflare R2 (see docs/runbooks/deployment.md §1.5).
# Alternatives: AWS S3 (Frankfurt) or self-hosted MinIO (--profile selfhosted-s3).
# Provider matrix:
#   R2 (prod)  — endpoint=https://<id>.r2.cloudflarestorage.com, region=auto,  path-style=false, SSE=false
#   AWS S3     — endpoint= (empty, SDK default),                  region=eu-central-1, path-style=false, SSE=true
#   MinIO (dev)— endpoint=http://minio:9000,                      region=us-east-1,    path-style=true,  SSE=false

# [REQUIRED for R2] R2 endpoint. AWS S3: leave empty (SDK default endpoint).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# false for R2 and AWS S3 (virtual-hosted style). true ONLY for local MinIO (path-style).
S3_FORCE_PATH_STYLE=false

# [REQUIRED] R2: auto. AWS S3 Frankfurt: eu-central-1.
S3_REGION=auto

# [REQUIRED] Bucket name for document storage.
S3_BUCKET=crm-documents-prod

# Server-side encryption (SSE-S3 AES-256 header).
#   false — R2 (rejects the SSE-S3 header; encrypts at rest by default) and MinIO.
#   true  — AWS S3 only.
S3_USE_SSE=false

# [REQUIRED] IAM user credentials with s3:GetObject/PutObject/DeleteObject on S3_BUCKET.
# See docs/runbooks/s3-storage.md for least-privilege IAM policy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

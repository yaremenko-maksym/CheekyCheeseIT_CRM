*.log
.next/
.output/
.vinxi/

# Lighthouse CI report output (task-infra-seo-gates) — CI-generated, per-run
# artifact directory; uploaded as a GHA artifact on failure, never committed.
.lighthouseci/

# Git worktrees — agent scratch space (linked worktrees live here, each its own
# checkout). Ephemeral; must never be committed. Previously only in
# .git/info/exclude (local-only); a tracked rule here makes it shared.
.claude/worktrees/

# CodeGraph local index (per-machine SQLite knowledge graph; large, rebuildable
# via `codegraph init`). See docs/architecture/2026-06-12-codegraph-adoption.md.
.codegraph/

# Auto-generated by TanStack Router — regenerated on `pnpm dev`
apps/web/app/routeTree.gen.ts

# Environment
.env
.env.local
.env.production
apps/**/.env
apps/**/.env.local

# PM state — local only, never merge with feature branches
docs/specs/pm-state.json

# Brainstorming Visual Companion sessions
.superpowers/

# Playwright local screenshots (not part of repo)
profile-page.png
users-page.png
user-detail-page.png

# Test output
coverage/
playwright-report/
test-results/

# OS
.DS_Store
.vite/

# IDE
.vscode/

# Claude Code (user-local, not shared)
.claude/settings.local.json
.claude/.allow-direct-edits
.claude/coder-activity.log
.claude/coder-activity.log.old
.playwright-mcp/

# Agent debug artifacts — files agents create during "verification".
# These must NEVER be committed. If git add catches one, .gitignore stops it.
# If an agent commits via git add -A on already-tracked files, the agent has bug.
output.txt
debug-*.png
screenshot-*.png
test-telegram-*.mjs
test-telegram-*.js
apps/e2e/debug-*.png
apps/e2e/screenshot-*.png
apps/e2e/test-*.mjs
apps/e2e/test-*.js
apps/e2e/temp-*
apps/e2e/scratch-*

# Visual verification screenshots (PM/agents save locally; do not commit to repo)
/*.png
/*.jpg
/*.jpeg
.claude/tasks/*.png

# QA / manual-qa screenshots and local test configs (agent artifacts)
qa-screenshots/
manual-qa-screenshots/
apps/web/.env.qa
apps/web/vite.qa.config.ts
.claude/tasks/*.jpg
.claude/tasks/*.jpeg
# Whitelist legitimate assets under apps/web/public/ (favicon, og-image, etc.)
!apps/web/public/**/*.png
!apps/web/public/**/*.jpg
!apps/web/public/**/*.jpeg

# Claude Design sync workspace + bundle output (regenerable via /design-sync;
# CLI scaffolding with its own node_modules — NEVER commit). See
# .claude/skills/claude-design-workflow/.
.ds-sync/
ds-bundle/

# Agent debug artifacts — files agents create during "verification".
# These must NEVER be committed. If git add catches one, .gitignore stops it.
# If an agent commits via git add -A on already-tracked files, the agent has bug.
output.txt
debug-*.png
screenshot-*.png
test-telegram-*.mjs

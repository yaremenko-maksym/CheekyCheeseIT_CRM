{
  "name": "cheeky-cheese-crm",
  "private": true,
  "packageManager": "pnpm@7.32.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:start": "docker compose up -d && docker compose ps && pnpm dev",
    "dev:stop": "docker compose stop",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "mutation:changed": "node scripts/devops/mutation-gate.mjs --changed",
    "mutation:full": "node scripts/devops/mutation-gate.mjs --full",
    "clean": "turbo clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.0",
    "turbo": "^2.9.14",
    "typescript": "^5.8.0",
    "vitest": "4.1.8"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm --filter @crm/web exec eslint --fix",
      "prettier --write"
    ],
    "apps/api/**/*.ts": [
      "pnpm --filter @crm/api exec eslint --fix",
      "prettier --write"
    ],
    "apps/e2e/**/*.ts": [
      "prettier --write"
    ],
    "packages/shared/**/*.ts": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "packages/**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "fastify": "^5.12.0",
      "find-my-way": ">=9.7.0 <10.0.0",
      "fast-uri": ">=3.1.5 <4.0.0",
      "ws": ">=8.20.1",
      "brace-expansion": ">=5.0.6"
    }
  }
}

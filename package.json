{
  "name": "cheeky-cheese-crm",
  "private": true,
  "packageManager": "pnpm@7.32.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:start": "docker compose up -d && docker compose ps && pnpm dev",
    "dev:stop": "docker compose stop",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.0",
    "turbo": "^2.9.14",
    "typescript": "^5.8.0"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm --filter @crm/web exec eslint --fix",
      "prettier --write"
    ],
    "apps/api/**/*.ts": [
      "pnpm --filter @crm/api exec eslint --fix",
      "prettier --write"
    ],
    "apps/e2e/**/*.ts": [
      "prettier --write"
    ],
    "packages/shared/**/*.ts": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "packages/**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "fastify": "^5.8.5",
      "fast-uri": ">=3.1.2",
      "ws": ">=8.20.1",
      "brace-expansion": ">=5.0.6"
    }
  }
}
